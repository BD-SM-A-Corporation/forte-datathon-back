# REQUIRED: generate a long random secret. No default credential is supplied.
API_KEY=
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=analysis
UPLOAD_DIR=storage/uploads
RULES_PATH=rules/regulations.json
MAX_UPLOAD_MB=512
MAX_DURATION_SEC=150
MAX_VIDEO_PIXELS=8294400
MAX_DECODED_FRAMES=18000
BASE_SAMPLE_FPS=1
DETAILED_SAMPLE_FPS=3
WINDOW_DURATION_SEC=5
WINDOW_OVERLAP_SEC=1
MOTION_THRESHOLD=0.04
MOTION_PIXEL_THRESHOLD=25
MOTION_MERGE_GAP_SEC=1
INFERENCE_MAX_SIDE=448
# Optional normalized [left,top,right,bottom]; keep unset for the full scene.
# ROI=[0.1,0.1,0.9,0.9]
QWEN_MODEL_PATH=weights/Qwen2.5-VL-3B-Instruct
# cpu or cuda
MODEL_DEVICE=cpu
MODEL_QUANTIZATION=none
MAX_NEW_TOKENS=512
MAX_FRAMES_PER_WINDOW=12
GENERATION_RETRIES=1
MAX_REFINEMENT_WINDOWS=8
PROCESSING_BUDGET_SEC=300
RESULT_TTL_SEC=86400
QUEUE_TTL_SEC=3600
EVENT_MERGE_GAP_SEC=0.2
CORS_ORIGINS=["http://localhost:3000"]
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# FRONTEND_IMAGE=your-existing-nextjs-image:tag
