# Server & Environment
ENVIRONMENT=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Authentication (for jury requests)
API_KEY=forte_hackathon_jury_secret_key

# CORS configuration (Next.js frontend and local dev)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://*.vercel.app"]

# Paths & Storage
DATABASE_URL=sqlite+aiosqlite:///storage/db.sqlite3
UPLOAD_DIR=storage/uploads
FRAMES_DIR=storage/frames
RULES_PATH=rules/rules.yaml
WEIGHTS_DIR=weights

# Pipeline parameters
FPS_SAMPLE_RATE=5
CONFIDENCE_THRESHOLD=0.50
DEVICE=cpu # 'cpu' or 'cuda'

# Redis (optional, fallback to internal background worker)
USE_REDIS_QUEUE=false
REDIS_URL=redis://localhost:6379/0
